<Project Sdk="Microsoft.NET.Sdk">
  <!-- Cross-platform core: lyrics, matching, sync, insights, palettes, renderer payloads.
       No Windows APIs here, so it builds and is tested on any OS. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Apmuly.Core</RootNamespace>
    <AssemblyName>Apmuly.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Apmuly.Core.Tests" />
  </ItemGroup>
</Project>
