<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows host: WPF window + WebView2 running the shared three.js renderer from App/Resources/Renderer. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- Lets the project restore and compile on macOS/Linux; it only runs on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>Apmuly.Windows</RootNamespace>
    <AssemblyName>Apmuly</AssemblyName>
    <ApplicationIcon>Assets\apmuly.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <Platforms>AnyCPU;x64;ARM64</Platforms>
    <!-- Self-contained, unpacked publish (WebView2 + WPF don't trim). -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- LibraryImport (DWM dark title bar) generates unsafe marshalling code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="NAudio.Wasapi" Version="3.3.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Apmuly.Core\Apmuly.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\apmuly.ico" />
  </ItemGroup>

  <!-- The shared renderer, linked (not copied into windows/) and served from the output folder. -->
  <ItemGroup>
    <Content Include="..\..\..\App\Resources\Renderer\**\*"
             Exclude="..\..\..\App\Resources\Renderer\**\.DS_Store"
             LinkBase="Renderer"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Link="README.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\..\THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
